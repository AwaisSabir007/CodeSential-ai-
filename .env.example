# CodeSentinel AI — Environment Config Template
# Copy this file to .env and fill in real values. Never commit .env.

# LLM Providers — set the one you want to use
CODESENTINEL_DEFAULT_LLM_PROVIDER=gemini   # gemini | openai | ollama | none

CODESENTINEL_GEMINI_API_KEY=your-gemini-api-key-here
CODESENTINEL_GEMINI_MODEL=gemini-1.5-flash

CODESENTINEL_OPENAI_API_KEY=sk-your-openai-key-here
CODESENTINEL_OPENAI_MODEL=gpt-4o-mini

CODESENTINEL_OLLAMA_BASE_URL=http://localhost:11434
CODESENTINEL_OLLAMA_DEFAULT_MODEL=codellama:7b
